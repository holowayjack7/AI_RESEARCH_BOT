# Environment variables
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data files created at runtime — but keep the tracked state file
# addable (a bare `data/` rule would make `git add data/state.json`
# fail in CI with "paths are ignored")
data/*
!data/state.json

# Legacy root state files (superseded by data/state.json)
/state.json
/seen.json
