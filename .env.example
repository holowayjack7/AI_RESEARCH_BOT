# AI Research Bot — Environment Variables
# Copy this file to .env and fill in your API keys

# === Web Search API (news + trusted domains) ===
TAVILY_API_KEY=

# === LLM API (analysis) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# === Telegram Bot (optional — export-only run without it) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Feature flags: sources ===
# arXiv and Hugging Face Daily Papers need no API keys
ENABLE_ARXIV=true
ENABLE_HF_PAPERS=true

# === Sources: papers ===
ARXIV_MAX_RESULTS=15
HF_MAX_RESULTS=15
PAPER_MAX_AGE_DAYS=3

# === Curation limits & quality thresholds ===
MAX_CANDIDATES_FOR_RESEARCH=24
MIN_SOURCE_QUALITY=7
MIN_IMPORTANCE=6
MIN_RELEVANCE=6
MIN_ACTIONABILITY=5
MIN_CONFIDENCE=65

# === HTTP / rate limiting ===
# Minimum interval between outbound HTTP requests (seconds)
RATE_LIMIT_SECONDS=1.0

# === Logging / publishing ===
LOG_LEVEL=INFO
STRUCTURED_LOGS=true
DATA_DIR=data
